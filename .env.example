# Hallow local runtime environment.
# Copy to ~/.hallow/.env for a normal install, or .hallow-dev/.env for source/dev runs.

# Optional model providers. Leave empty until you have real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# Optional local/OpenAI-compatible endpoints.
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1
TEXT_GENERATION_WEBUI_BASE_URL=http://localhost:8080/v1

# Optional gateway tokens. Keep real values only in the local Hallow home.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
